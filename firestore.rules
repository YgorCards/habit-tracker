rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      function validProfile() {
        return request.resource.data.keys().hasOnly(['displayName'])
          && request.resource.data.keys().hasAll(['displayName'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 100;
      }

      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create, update: if isOwner(uid) && validProfile();

      match /habits/{habitId} {
        function validHabit() {
          return request.resource.data.keys().hasAll([
              'name', 'color', 'createdAt'
            ])
            && request.resource.data.keys().hasOnly([
              'name', 'color', 'createdAt'
            ])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 36
            && request.resource.data.color in [
              '#9a7cff', '#4ab8f0', '#43c985',
              '#f06f9b', '#f3a44e', '#e4cb54'
            ]
            && request.resource.data.createdAt == request.time;
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validHabit();
      }

      match /activities/{activityId} {
        function validActivity() {
          return request.resource.data.keys().hasAll([
              'habitId', 'date', 'minutes', 'note', 'createdAt'
            ])
            && request.resource.data.keys().hasOnly([
              'habitId', 'date', 'minutes', 'note', 'createdAt'
            ])
            && request.resource.data.habitId is string
            && request.resource.data.habitId.size() > 0
            && exists(
              /databases/$(database)/documents/users/$(uid)/habits/$(request.resource.data.habitId)
            )
            && request.resource.data.date is string
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.minutes is int
            && request.resource.data.minutes > 0
            && request.resource.data.minutes <= 1440
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 120
            && request.resource.data.createdAt == request.time;
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validActivity();
      }
    }
  }
}
